# LocalStack configuration. Copy to .env for local runs; CI sets these itself.
# Everything here is local-only - LocalStack never touches a real AWS account.

# The free emulation listens on one port for all services.
LOCALSTACK_AUTH_TOKEN=
# Raise only while debugging.
LOCALSTACK_DEBUG=0
# Optional: pin feature flags (see localstack docs). Default (empty) is fine.
LOCALSTACK_FEATURE_FLAGS=